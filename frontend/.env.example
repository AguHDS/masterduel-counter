# Cloudinary
# Use your Cloudinary name (same in development and production)
VITE_CLOUDINARY_NAME=

# Environment for query stale time and URL selection
# Change in production to: production
VITE_QUERY_ENV=development

# Backend API URL (used by some legacy code)
# Change in production to: https://masterduelcounter.com/api
VITE_API_URL=http://localhost:3001

# Cloudflare Turnstile (CAPTCHA)
# Use your production site key in production
VITE_TURNSTILE_SITE_KEY=

# Sentry DSN for error tracking
# Optional: Add your Sentry DSN for production error monitoring
VITE_SENTRY_DSN=