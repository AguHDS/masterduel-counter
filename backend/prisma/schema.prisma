datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id
  name          String   @map("namedb")
  email         String   @unique @map("emaildb")
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  role          String   @default("user") // Roles: "user", "supporter", "admin"
  lastUsernameChange DateTime? @map("last_username_change")
  lastActiveAt DateTime? @map("last_active_at")

  sessions     Session[]
  accounts     Account[]
  verification Verification[]
  archetypeInstances ArchetypeInstance[]
  instanceLikes InstanceLike[]
  instanceFavorites InstanceFavorite[]
  profile      Profile?
  reportsCreated Report[] @relation("ReporterUser")
  reportsReceived Report[] @relation("ReportedUser")
  comments     Comment[]
  notifications Notification[]
  customDecks  CustomDeck[]
  guideRequestsCreated  GuideRequest[] @relation("RequestCreator")
  guideRequestsFulfilled GuideRequest[] @relation("RequestFulfiller")
  guideRequestsTaken    GuideRequest[] @relation("RequestTaker")
  latestUpdates         LatestUpdate[]

  banned     Boolean?  @default(false)
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires")

  @@map("users")
}

model Profile {
  id                    Int       @id @default(autoincrement())
  userId                String    @unique @map("user_id")
  bio                   String?
  profilePictureUrl     String?   @map("profile_picture_url")
  cloudinaryPublicId    String?   @map("cloudinary_public_id")
  favoriteCardId        Int?      @map("favorite_card_id")
  favoriteDecks         String?   @map("favorite_decks") // JSON: [{ archetypeId, archetypeName, cardId }]
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String? @map("impersonated_by")

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  expiresAt             DateTime? @map("expires_at")
  password              String?
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")
  userId     String?   @map("user_id")
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification")
}

model Archetype {
  id               Int       @id @default(autoincrement())
  name             String    @unique
  registered       Boolean   @default(false)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @map("updated_at")

  instances        ArchetypeInstance[]
  guideRequests    GuideRequest[]

  @@map("archetypes")
}

model ArchetypeInstance {
  id               Int       @id @default(autoincrement())
  archetypeId      Int       @map("archetype_id")
  userId           String    @map("user_id")
  title            String    @default("Title")
  headerCardId     Int?      @map("header_card_id")
  generalTip       String?   @map("general_tip")
  guideType        String    @default("COUNTER") @map("guide_type")
  isDraft          Boolean   @default(false) @map("is_draft")
  draftExpiresAt   DateTime? @map("draft_expires_at")
  guideRequestId   Int?      @map("guide_request_id")
  likes            Int       @default(0)
  favorites        Int       @default(0)
  views            Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  archetype        Archetype @relation(fields: [archetypeId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  headerCard       Card?     @relation("InstanceHeaderCard", fields: [headerCardId], references: [id], onDelete: SetNull)
  cardPairs        ArchetypeCardPair[]
  initialHands     InitialHand[]
  reports          Report[]
  likeRecords      InstanceLike[]
  favoriteRecords  InstanceFavorite[]
  guideRequest     GuideRequest? @relation(fields: [guideRequestId], references: [id])
  recommendedDeck  RecommendedDeck?
  comments         Comment[]
  notifications    Notification[]

  @@index([userId])
  @@index([archetypeId])
  @@index([guideType])
  @@map("archetype_instances")
}

model Comment {
  id          Int       @id @default(autoincrement())
  content     String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  instanceId  Int       @map("instance_id")
  instance    ArchetypeInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  
  authorId    String    @map("author_id")
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Self-relation for replies
  parentCommentId Int?   @map("parent_comment_id")
  parentComment   Comment? @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[] @relation("CommentReplies")

  notifications   Notification[]

  @@index([instanceId])
  @@index([authorId])
  @@index([parentCommentId])
  @@index([createdAt])
  @@map("comments")
}

// Anonymous view tracking for guides
// Tracks views with 12-hour cooldown per viewer/guide combination
// Uses SHA256 hashed fingerprint (cookie-based) to identify viewers anonymously
// Cleaned up automatically by cleanupService.ts (entries older than 30 days)
model GuideViewTracking {
  instanceId        Int      @map("instance_id")
  viewerFingerprint String   @map("viewer_fingerprint")
  lastViewedAt      DateTime @map("last_viewed_at")
  createdAt         DateTime @default(now()) @map("created_at")

  @@id([instanceId, viewerFingerprint])
  @@index([lastViewedAt])
  @@map("guide_view_tracking")
}

// Card storage with YGOProdeck direct URLs
// Images are served directly from YGOProdeck CDN (https://images.ygoprodeck.com)
// Each card is uniquely identified by id (PRIMARY KEY prevents duplicates)
model Card {
  id                      Int       @id
  name                    String
  type                    String?   // e.g., "Effect Monster", "Spell Card", "Trap Card" - TEMP optional until data migration
  desc                    String?   // Card description/effect text - TEMP optional until data migration
  race                    String?   // e.g., "Dragon", "Warrior", "Quick-Play Spell" - TEMP optional until data migration
  attribute               String?   // e.g., "DARK", "LIGHT" (monsters only)
  atk                     Int?      // Attack points (monsters only)
  def                     Int?      // Defense points (monsters only)
  level                   Int?      // Level/Rank (monsters only)
  scale                   Int?      // Pendulum scale (pendulum monsters only)
  linkval                 Int?      // Link rating (link monsters only)
  linkmarkers             String?   // JSON array: ["Top", "Bottom-Left"] (link monsters only)
  archetype               String?   // Archetype name if applicable
  imageUrl                String    @map("image_url")
  imageUrlSmall           String    @map("image_url_small")
  imageUrlCropped         String    @map("image_url_cropped")
  frameType               String?   @map("frame_type")
  createdAt               DateTime  @default(now()) @map("created_at")

  instanceHeaders        ArchetypeInstance[] @relation("InstanceHeaderCard")
  topCardPairs           CardPairTop[] @relation("TopCardPairs")
  bottomCardPairs        CardPairBottom[] @relation("BottomCardPairs")
  comboStepMainCards     ComboStepMainCard[] @relation("ComboStepMainCards")
  comboStepSubCards      ComboStepSubCard[] @relation("ComboStepSubCards")
  comboStepLeftSubCards  ComboStepLeftSubCard[] @relation("ComboStepLeftSubCards")

  @@index([name])
  @@map("cards")
}

model ArchetypeCardPair {
  id            Int       @id @default(autoincrement())
  instanceId    Int       @map("instance_id")
  pairOrder     Int       @map("pair_order")
  pairSection   String?   @map("pair_section")
  comment       String?
  createdAt     DateTime  @default(now()) @map("created_at")

  instance      ArchetypeInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  topCards      CardPairTop[]
  bottomCards   CardPairBottom[]

  @@index([instanceId])
  @@map("archetype_card_pairs")
}

model CardPairTop {
  id        Int       @id @default(autoincrement())
  pairId    Int       @map("pair_id")
  cardId    Int       @map("card_id")
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  pair      ArchetypeCardPair @relation(fields: [pairId], references: [id], onDelete: Cascade)
  card      Card      @relation("TopCardPairs", fields: [cardId], references: [id], onDelete: Cascade)

  @@index([pairId])
  @@map("card_pair_top")
}

model CardPairBottom {
  id            Int       @id @default(autoincrement())
  pairId        Int       @map("pair_id")
  cardId        Int       @map("card_id")
  position      Int       @default(0)
  effectiveness String?
  createdAt     DateTime  @default(now()) @map("created_at")

  pair      ArchetypeCardPair @relation(fields: [pairId], references: [id], onDelete: Cascade)
  card      Card      @relation("BottomCardPairs", fields: [cardId], references: [id], onDelete: Cascade)

  @@index([pairId])
  @@map("card_pair_bottom")
}

model InitialHand {
  id          Int       @id @default(autoincrement())
  instanceId  Int       @map("instance_id")
  cardIds     String    @map("card_ids") // JSON array of card IDs (max 5)
  description String?   // Optional description (max 50 characters)
  finalBoardState String? @map("final_board_state")
  position    Int       @default(0) // Order of the initial hand
  createdAt   DateTime  @default(now()) @map("created_at")

  instance    ArchetypeInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  comboSteps  ComboStep[]

  @@index([instanceId])
  @@map("initial_hands")
}

model ComboStep {
  id                    Int       @id @default(autoincrement())
  initialHandId         Int       @map("initial_hand_id")
  stepOrder             Int       @map("step_order")
  description           String?
  parentCanceledStepId  Int?      @map("parent_canceled_step_id")
  createdAt             DateTime  @default(now()) @map("created_at")

  initialHand           InitialHand @relation(fields: [initialHandId], references: [id], onDelete: Cascade)
  parentCanceledStep    ComboStep?  @relation("CanceledFlow", fields: [parentCanceledStepId], references: [id], onDelete: Cascade)
  canceledSteps         ComboStep[] @relation("CanceledFlow")
  mainCards             ComboStepMainCard[]
  subCards              ComboStepSubCard[]
  leftSubCards          ComboStepLeftSubCard[]

  @@index([initialHandId])
  @@index([parentCanceledStepId])
  @@map("combo_steps")
}

model ComboStepMainCard {
  id          Int       @id @default(autoincrement())
  stepId      Int       @map("step_id")
  cardId      Int       @map("card_id")
  position    Int       @default(0)
  chainNumber Int?      @map("chain_number")
  createdAt   DateTime  @default(now()) @map("created_at")

  step      ComboStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  card      Card      @relation("ComboStepMainCards", fields: [cardId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@map("combo_step_main_cards")
}

model ComboStepSubCard {
  id          Int       @id @default(autoincrement())
  stepId      Int       @map("step_id")
  cardId      Int       @map("card_id")
  position    Int       @default(0)
  chainNumber Int?      @map("chain_number")
  createdAt   DateTime  @default(now()) @map("created_at")

  step      ComboStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  card      Card      @relation("ComboStepSubCards", fields: [cardId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@map("combo_step_sub_cards")
}

model ComboStepLeftSubCard {
  id          Int       @id @default(autoincrement())
  stepId      Int       @map("step_id")
  cardId      Int       @map("card_id")
  position    Int       @default(0)
  chainNumber Int?      @map("chain_number")
  createdAt   DateTime  @default(now()) @map("created_at")

  step      ComboStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  card      Card      @relation("ComboStepLeftSubCards", fields: [cardId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@map("combo_step_left_sub_cards")
}

model InstanceLike {
  id          Int       @id @default(autoincrement())
  instanceId  Int       @map("instance_id")
  userId      String    @map("user_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  instance    ArchetypeInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([instanceId, userId])
  @@index([instanceId])
  @@index([userId])
  @@map("instance_likes")
}

model InstanceFavorite {
  id          Int       @id @default(autoincrement())
  instanceId  Int       @map("instance_id")
  userId      String    @map("user_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  instance    ArchetypeInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([instanceId, userId])
  @@index([instanceId])
  @@index([userId])
  @@map("instance_favorites")
}

model RecommendedDeck {
  id              Int       @id @default(autoincrement())
  instanceId      Int       @unique @map("instance_id")
  title           String?   @default("Recommended Deck")
  mainDeckCards   String    @map("main_deck_cards") // JSON array of card IDs in order
  extraDeckCards  String    @map("extra_deck_cards") // JSON array of card IDs in order
  sideDeckCards   String    @default("[]") @map("side_deck_cards") // JSON array of card IDs in order (max 20)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  instance        ArchetypeInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("recommended_decks")
}

model CustomDeck {
  id              Int       @id @default(autoincrement())
  userId          String    @map("user_id")
  title           String    @default("Custom Deck")
  mainDeckCards   String    @map("main_deck_cards") // JSON array of card IDs in order
  extraDeckCards  String    @map("extra_deck_cards") // JSON array of card IDs in order
  sideDeckCards   String    @default("[]") @map("side_deck_cards") // JSON array of card IDs in order (max 20)
  headerCardId    Int?      @map("header_card_id") // Optional card ID for custom preview image
  isPublic        Boolean   @default(false) @map("is_public")
  displayOrder    Int       @default(0) @map("display_order") // User-defined order for display (lower = first)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, displayOrder])
  @@map("custom_decks")
}

model Report {
  id                  Int       @id @default(autoincrement())
  reporterId          String    @map("reporter_id")
  reportedUserId      String?   @map("reported_user_id")
  reportedInstanceId  Int?      @map("reported_instance_id")
  reason              String
  status              String    @default("pending") // pending, resolved, dismissed
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  reporter            User      @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser        User?     @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reportedInstance    ArchetypeInstance? @relation(fields: [reportedInstanceId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([reportedInstanceId])
  @@index([status])
  @@map("reports")
}

model Notification {
  id          Int       @id @default(autoincrement())
  userId      String    @map("user_id")
  type        String    // 'comment', 'like', 'favorite', 'guide_request_fulfilled'
  read        Boolean   @default(false)
  count       Int       @default(1) // For aggregated likes/favorites
  
  // References
  instanceId  Int?      @map("instance_id")
  commentId   Int?      @map("comment_id")
  
  // Actor info (who triggered the notification)
  actorId     String?   @map("actor_id")
  actorName   String?   @map("actor_name")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  // Relations
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance    ArchetypeInstance?  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  comment     Comment?            @relation(fields: [commentId], references: [id], onDelete: Cascade)
  
  @@index([userId, read])
  @@index([userId, instanceId, type])
  @@map("notifications")
}

model GuideRequest {
  id                  Int       @id @default(autoincrement())
  title               String
  description         String?
  archetypeId         Int       @map("archetype_id")
  guideType           String    @default("COUNTER") @map("guide_type") // COUNTER | DECK
  status              String    @default("OPEN") // OPEN | TAKEN | COMPLETED
  requesterId         String?   @map("requester_id")
  requesterAlias      String    @map("requester_alias") // stored at create time: username or Anonymous-N
  fulfilledById       String?   @map("fulfilled_by_id")
  fulfilledInstanceId Int?      @map("fulfilled_instance_id")
  takenById           String?   @map("taken_by_id")
  takenAt             DateTime? @map("taken_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  archetype   Archetype @relation(fields: [archetypeId], references: [id], onDelete: Cascade)
  requester   User?     @relation("RequestCreator", fields: [requesterId], references: [id], onDelete: SetNull)
  fulfilledBy User?     @relation("RequestFulfiller", fields: [fulfilledById], references: [id], onDelete: SetNull)
  takenBy     User?     @relation("RequestTaker", fields: [takenById], references: [id], onDelete: SetNull)

  draftInstances ArchetypeInstance[]

  @@index([status])
  @@index([archetypeId])
  @@index([requesterId])
  @@index([fulfilledById])
  @@index([takenById])
  @@map("guide_requests")
}

model MonthlyGuideRanking {
  id         Int      @id @default(autoincrement())
  guideId    Int      @map("guide_id")
  month      String   // Format: YYYY-MM (e.g., "2026-05")
  rank       Int
  score      Float
  likes      Int
  views      Int
  favorites  Int
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([guideId, month])
  @@index([month])
  @@index([month, rank])
  @@map("monthly_guide_rankings")
}

model MonthlyUserRanking {
  id                 Int      @id @default(autoincrement())
  userId             String   @map("user_id")
  month              String   // Format: YYYY-MM (e.g., "2026-05")
  rank               Int
  score              Float
  totalLikes         Int      @map("total_likes")
  totalViews         Int      @map("total_views")
  fulfilledRequests  Int      @map("fulfilled_requests")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([userId, month])
  @@index([month])
  @@index([month, rank])
  @@map("monthly_user_rankings")
}

model LatestUpdate {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   // Rich text (HTML)
  authorId  String   @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([createdAt])
  @@map("latest_updates")
}
