datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id
  name          String   @map("namedb")
  email         String   @unique @map("emaildb")
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  role          String   @default("user")
  lastUsernameChange DateTime? @map("last_username_change")
  lastActiveAt DateTime? @map("last_active_at")

  sessions     Session[]
  accounts     Account[]
  verification Verification[]
  archetypeInstances ArchetypeInstance[]
  instanceLikes InstanceLike[]
  instanceFavorites InstanceFavorite[]
  profile      Profile?
  reportsCreated Report[] @relation("ReporterUser")
  reportsReceived Report[] @relation("ReportedUser")
  comments     Comment[]
  notifications Notification[]
  customDecks  CustomDeck[]

  banned     Boolean?  @default(false)
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires")

  @@map("users")
}

model Profile {
  id                    Int       @id @default(autoincrement())
  userId                String    @unique @map("user_id")
  bio                   String?
  profilePictureUrl     String?   @map("profile_picture_url")
  cloudinaryPublicId    String?   @map("cloudinary_public_id")
  favoriteCardId        Int?      @map("favorite_card_id")
  favoriteDecks         String?   @map("favorite_decks") // JSON: [{ archetypeId, archetypeName, cardId }]
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String? @map("impersonated_by")

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  expiresAt             DateTime? @map("expires_at")
  password              String?
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")
  userId     String?   @map("user_id")
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification")
}

model Archetype {
  id               Int       @id @default(autoincrement())
  name             String    @unique
  registered       Boolean   @default(false)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @map("updated_at")

  instances        ArchetypeInstance[]

  @@map("archetypes")
}

model ArchetypeInstance {
  id               Int       @id @default(autoincrement())
  archetypeId      Int       @map("archetype_id")
  userId           String    @map("user_id")
  title            String    @default("Title")
  headerCardId     Int?      @map("header_card_id")
  generalTip       String?   @map("general_tip")
  likes            Int       @default(0)
  favorites        Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  archetype        Archetype @relation(fields: [archetypeId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  headerCard       Card?     @relation("InstanceHeaderCard", fields: [headerCardId], references: [id], onDelete: SetNull)
  cardPairs        ArchetypeCardPair[]
  reports          Report[]
  likeRecords      InstanceLike[]
  favoriteRecords  InstanceFavorite[]
  recommendedDeck  RecommendedDeck?
  comments         Comment[]
  notifications    Notification[]

  @@index([userId])
  @@index([archetypeId])
  @@map("archetype_instances")
}

model Comment {
  id          Int       @id @default(autoincrement())
  content     String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  instanceId  Int       @map("instance_id")
  instance    ArchetypeInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  
  authorId    String    @map("author_id")
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Self-relation for replies
  parentCommentId Int?   @map("parent_comment_id")
  parentComment   Comment? @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[] @relation("CommentReplies")

  notifications   Notification[]

  @@index([instanceId])
  @@index([authorId])
  @@index([parentCommentId])
  @@index([createdAt])
  @@map("comments")
}

// Card storage with Cloudinary integration
// isTemporary: Failsafe flag used ONLY during confirmSelectedCards process:
//              1. Cards are created with isTemporary=true
//              2. Then marked isTemporary=false after successful creation
//              If server crashes DURING this process, cards remain temporary and are cleaned by cron.
//              Cards selected but never saved don't reach DB at all (only in browser memory).
model Card {
  id                      Int       @id
  name                    String
  imageUrl                String    @map("image_url")
  imageUrlSmall           String    @map("image_url_small")
  imageUrlCropped         String    @map("image_url_cropped")
  cloudinaryPublicId      String    @map("cloudinary_public_id")
  cloudinaryPublicIdSmall String    @map("cloudinary_public_id_small")
  cloudinaryPublicIdCropped String  @map("cloudinary_public_id_cropped")
  isTemporary             Boolean   @default(true) @map("is_temporary") // Failsafe cleanup flag
  createdAt               DateTime  @default(now()) @map("created_at")

  instanceHeaders        ArchetypeInstance[] @relation("InstanceHeaderCard")
  topCardPairs           CardPairTop[] @relation("TopCardPairs")
  bottomCardPairs        CardPairBottom[] @relation("BottomCardPairs")

  @@index([name])
  @@index([isTemporary, createdAt]) // For efficient cleanup queries
  @@map("cards")
}

model ArchetypeCardPair {
  id            Int       @id @default(autoincrement())
  instanceId    Int       @map("instance_id")
  pairOrder     Int       @map("pair_order")
  effectiveness String?
  comment       String?
  createdAt     DateTime  @default(now()) @map("created_at")

  instance      ArchetypeInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  topCards      CardPairTop[]
  bottomCards   CardPairBottom[]

  @@index([instanceId])
  @@map("archetype_card_pairs")
}

model CardPairTop {
  id        Int       @id @default(autoincrement())
  pairId    Int       @map("pair_id")
  cardId    Int       @map("card_id")
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  pair      ArchetypeCardPair @relation(fields: [pairId], references: [id], onDelete: Cascade)
  card      Card      @relation("TopCardPairs", fields: [cardId], references: [id], onDelete: Cascade)

  @@index([pairId])
  @@map("card_pair_top")
}

model CardPairBottom {
  id        Int       @id @default(autoincrement())
  pairId    Int       @map("pair_id")
  cardId    Int       @map("card_id")
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  pair      ArchetypeCardPair @relation(fields: [pairId], references: [id], onDelete: Cascade)
  card      Card      @relation("BottomCardPairs", fields: [cardId], references: [id], onDelete: Cascade)

  @@index([pairId])
  @@map("card_pair_bottom")
}

model InstanceLike {
  id          Int       @id @default(autoincrement())
  instanceId  Int       @map("instance_id")
  userId      String    @map("user_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  instance    ArchetypeInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([instanceId, userId])
  @@index([instanceId])
  @@index([userId])
  @@map("instance_likes")
}

model InstanceFavorite {
  id          Int       @id @default(autoincrement())
  instanceId  Int       @map("instance_id")
  userId      String    @map("user_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  instance    ArchetypeInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([instanceId, userId])
  @@index([instanceId])
  @@index([userId])
  @@map("instance_favorites")
}

model RecommendedDeck {
  id              Int       @id @default(autoincrement())
  instanceId      Int       @unique @map("instance_id")
  title           String?   @default("Recommended Deck")
  mainDeckCards   String    @map("main_deck_cards") // JSON array of card IDs in order
  extraDeckCards  String    @map("extra_deck_cards") // JSON array of card IDs in order
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  instance        ArchetypeInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("recommended_decks")
}

model CustomDeck {
  id              Int       @id @default(autoincrement())
  userId          String    @map("user_id")
  title           String    @default("Custom Deck")
  mainDeckCards   String    @map("main_deck_cards") // JSON array of card IDs in order
  extraDeckCards  String    @map("extra_deck_cards") // JSON array of card IDs in order
  isPublic        Boolean   @default(false) @map("is_public")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("custom_decks")
}

model Report {
  id                  Int       @id @default(autoincrement())
  reporterId          String    @map("reporter_id")
  reportedUserId      String?   @map("reported_user_id")
  reportedInstanceId  Int?      @map("reported_instance_id")
  reason              String
  status              String    @default("pending") // pending, resolved, dismissed
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  reporter            User      @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser        User?     @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reportedInstance    ArchetypeInstance? @relation(fields: [reportedInstanceId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([reportedInstanceId])
  @@index([status])
  @@map("reports")
}

model Notification {
  id          Int       @id @default(autoincrement())
  userId      String    @map("user_id")
  type        String    // 'comment', 'like', 'favorite'
  read        Boolean   @default(false)
  count       Int       @default(1) // For aggregated likes/favorites
  
  // References
  instanceId  Int?      @map("instance_id")
  commentId   Int?      @map("comment_id")
  
  // Actor info (who triggered the notification)
  actorId     String?   @map("actor_id")
  actorName   String?   @map("actor_name")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  // Relations
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance    ArchetypeInstance?  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  comment     Comment?            @relation(fields: [commentId], references: [id], onDelete: Cascade)
  
  @@index([userId, read])
  @@index([userId, instanceId, type])
  @@map("notifications")
}
