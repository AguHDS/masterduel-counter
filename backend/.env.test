# Test database - separate from production database
# This file is loaded automatically by vitest via src/test-setup.ts
# Vitest also sets NODE_ENV=test automatically, but we declare it here for explicitness
#
# IMPORTANT: Values here OVERRIDE matching keys from .env (thanks to `override: true` in test-setup.ts)
# Keys NOT listed here keep their values from .env (e.g., JWT_SECRET, BETTER_AUTH_SECRET)

NODE_ENV=test
DATABASE_URL=file:./src/data/test.db

# Disable external service calls in tests
TURNSTILE_SECRET_KEY=
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
