PORT_FRONTEND=5173
PORT_BACKEND=3001

# Environment: development or production
# Change in production to: production
NODE_ENV=development

# CORS Origin for frontend-backend communication
# Change in production to: https://masterduelcounter.com
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=secret-key

# BetterAuth Secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-better-auth-secret-key

# Database URL for Prisma (in prod, uses DATABASE_URL=file:/var/www/masterduel-counter/backend/prisma/src/data/database.db)
DATABASE_URL=file:./src/data/database.db

# Cloudinary Configuration
CLOUDINARY_NAME=your cloudinary name
CLOUDINARY_API_KEY=your cloudinary api key
CLOUDINARY_API_SECRET=your cloudinary api secret

# Brevo SMTP Configuration (for email verification & password reset)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@smtp-brevo.com
SMTP_PASSWORD=your-brevo-smtp-password
SMTP_FROM_NAME=masterduelcounter
SMTP_FROM_EMAIL=noreply@masterduelcounter.com

# Email Verification
# Change in production to: true
REQUIRE_EMAIL_VERIFICATION=false

# Invalid Email Cleanup Service (someone registering with an email they don't own)
CLEANUP_UNVERIFIED_ACCOUNTS_ENABLED=true
UNVERIFIED_ACCOUNT_TTL_HOURS=24
CLEANUP_CRON_SCHEDULE=0 3 * * *

# Cloudflare Turnstile (CAPTCHA)
# Use your production secret key in production
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Discord OAuth
DISCORD_CLIENT_ID=discord client id
DISCORD_CLIENT_SECRET=discord client secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret